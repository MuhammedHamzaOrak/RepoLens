FOUNDRY_EMBEDDING_MODEL=qwen3-embedding-0.6b
FOUNDRY_CHAT_MODEL=qwen2.5-coder-1.5b
REPOLENS_DATA_DIR=./data
REPOLENS_MAX_UPLOAD_MB=25
REPOLENS_MAX_UNCOMPRESSED_MB=200
REPOLENS_MAX_FILES=5000
REPOLENS_MAX_SOURCE_FILE_KB=512
REPOLENS_EMBEDDING_BATCH_SIZE=32
REPOLENS_TOP_K=4
REPOLENS_MIN_SIMILARITY=0.50
REPOLENS_FALLBACK_ACCEPT_SIMILARITY=0.435
REPOLENS_FALLBACK_CONTEXT_SIMILARITY=0.37
REPOLENS_QUERY_INSTRUCTION=Given a question about a software repository, retrieve source passages that answer the question
REPOLENS_IMPLEMENTATION_QUERY_INSTRUCTION=Given a question about a software repository, retrieve source code passages that explain the implementation
REPOLENS_CHAT_MAX_TOKENS=180
REPOLENS_CHAT_TEMPERATURE=0.1
REPOLENS_CHAT_RANDOM_SEED=42
REPOLENS_IMPLEMENTATION_CONTEXT_CHUNKS=3
REPOLENS_MAX_CONTEXT_CHARS=24000
REPOLENS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
